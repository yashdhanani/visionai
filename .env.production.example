# VisionAI Production Environment Variables
# Copy this file to .env and fill in your values

# Application Settings
APP_ENV=production
APP_NAME=VisionAI
API_HOST=0.0.0.0
API_PORT=8001
WEB_BASE_URL=https://yourdomain.com
CORS_ORIGINS=https://yourdomain.com

# Database Configuration
DATABASE_URL=postgresql://visionai_user:secure_password@localhost:5432/visionai_db
DB_USER=visionai_user
DB_PASSWORD=your-secure-password-here
DB_NAME=visionai_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security - CHANGE THESE VALUES
JWT_SECRET=your-super-secure-jwt-secret-key-min-32-chars-recommended
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password

# Model Configuration
MODEL_NAME=yolov8n.pt
MODEL_PATH=./ml/models
MODEL_DEVICE=auto
FACE_MODEL_NAME=yolov8n-face.pt
PLATE_MODEL_NAME=yolov8m-plate.pt
MODEL_CONFIDENCE=0.35
MODEL_IOU=0.45
MAX_WEBSOCKET_FPS=30

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_ROOT=./data/uploads
MAX_UPLOAD_SIZE_MB=10
MAX_VIDEO_UPLOAD_SIZE_MB=200

# Rate Limiting
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_DETECT_PER_MINUTE=120

# Email Configuration (optional)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-password

# AWS S3 Configuration (optional, if using S3 storage)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1